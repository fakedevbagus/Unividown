FROM python:3.11-slim-bookworm
WORKDIR /app
ARG INSTALL_AI=false
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get install -y --no-install-recommends ffmpeg libmagic1 && \
    rm -rf /var/lib/apt/lists/*
COPY services/worker/requirements.txt services/worker/requirements-ai.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    if [ "$INSTALL_AI" = "true" ]; then pip install --no-cache-dir -r requirements-ai.txt; fi && \
    pip uninstall -y msgpack setuptools wheel jaraco.context && \
    pip install --no-cache-dir msgpack==1.2.2 && \
    python -m pip uninstall -y pip && \
    rm -rf /usr/local/lib/python3.11/site-packages/setuptools* \
           /usr/local/lib/python3.11/site-packages/wheel* \
           /usr/local/lib/python3.11/site-packages/jaraco/context* \
           /usr/local/lib/python3.11/ensurepip \
           /root/.cache
COPY services/worker /app
ENV PYTHONUNBUFFERED=1 DATABASE_URL="sqlite:////app/data/unividown.db" UPLOAD_DIR="/app/data/uploads" DOWNLOAD_DIR="/app/data/downloads" PROCESSED_DIR="/app/data/processed"
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health/ready', timeout=3)"]
CMD ["uvicorn", "app.main:sio_app", "--host", "0.0.0.0", "--port", "8000"]
